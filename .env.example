# Akansha environment variables
#
# IMPORTANT: Akansha does not read a `.env` file at runtime -- there is no dotenv
# loader in the app, and adding one would mean a secret sitting in plain text in
# the project folder. This file documents the variable NAMES; set the ones you
# want as real user environment variables, for example:
#
#   [Environment]::SetEnvironmentVariable('AKANSHA_OPENROUTER_API_KEY','sk-or-...','User')
#
# The normal way to give Akansha a key is Settings > AI providers, which stores it
# encrypted with Windows DPAPI (Electron safeStorage) in %APPDATA%\Akansha. These
# variables exist so CI and power users can inject a key without the UI.
# Precedence: a key saved in the UI wins over the environment variable.
#
# Nothing here is required. Akansha's default provider is Ollama on this machine,
# which needs no key at all.

# --- API keys -----------------------------------------------------------------
# Pattern: AKANSHA_<PROVIDER>_API_KEY
AKANSHA_ANTHROPIC_API_KEY=
# Optional. Also used for cloud speech-to-text on the Voice page; local
# whisper.cpp is preferred and is the only engine allowed while the wake word is
# armed.
AKANSHA_OPENAI_API_KEY=
# Optional. One key in front of many models, including free ones.
AKANSHA_OPENROUTER_API_KEY=

# --- Base URLs ----------------------------------------------------------------
# Pattern: AKANSHA_<PROVIDER>_BASE_URL -- point a provider at a proxy or a
# self-hosted endpoint. Unset means the official default.
# AKANSHA_ANTHROPIC_BASE_URL=https://api.anthropic.com
# AKANSHA_OPENAI_BASE_URL=https://api.openai.com
# AKANSHA_OPENROUTER_BASE_URL=https://openrouter.ai/api
# Ollama runs locally and needs no key.
# AKANSHA_OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Development only ---------------------------------------------------------
# Set by `electron-vite dev`; do not set it yourself.
# ELECTRON_RENDERER_URL=http://localhost:5173
